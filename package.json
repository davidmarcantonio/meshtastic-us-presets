{
  "name": "meshtastic-us-presets",
  "version": "1.0.0",
  "description": "Meshtastic community radio settings for the United States, one JSON file per community.",
  "private": true,
  "type": "module",
  "license": "CC0-1.0",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "index": "node scripts/build-index.mjs",
    "format": "node scripts/build-index.mjs --format",
    "check": "node scripts/validate.mjs && node scripts/build-index.mjs --check"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
